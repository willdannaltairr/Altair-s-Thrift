# Demo / local development only — copy to .env files. Never commit real secrets.
# Backend: copy to backend/.env — SQLite local (mudah di-migrate ke PostgreSQL nanti)
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-min-32-chars-local-only"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="altair_session"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
PORT="4000"
NODE_ENV="development"
PAYMENT_WEBHOOK_SECRET="local-payment-webhook-secret"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
S3_ENDPOINT=""
S3_BUCKET="altairs-thrift-local"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
