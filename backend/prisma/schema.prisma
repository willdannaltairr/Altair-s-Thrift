generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- SQLite note ----------
// SQLite via Prisma 5 does NOT support native enums, Json, or scalar lists.
// All status fields are String + Zod-validated in `src/validators/*`.
// Allowed values are documented per field.
// To migrate to PostgreSQL later:
//   1. provider = "postgresql"
//   2. restore `enum` blocks (see git history) and Json/String[] types
//   3. re-add `mode: 'insensitive'` in products.ts / admin.ts
// Status value catalog (single source of truth, mirrored in Zod):
//   AccountStatus: ACTIVE | SUSPENDED | BANNED
//   StoreStatus: DRAFT | ACTIVE | SUSPENDED
//   StoreTheme: MINIMAL | STREETWEAR | CLASSIC
//   VerificationStatus: PENDING | APPROVED | REJECTED
//   ProductCondition: NEW | LIKE_NEW | GOOD | FAIR
//   ProductStatus: DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | ARCHIVED
//   PaymentStatus: PENDING | PAID | FAILED | EXPIRED | REFUNDED
//   OrderStatus: PENDING_PAYMENT | PAID | PROCESSING | SHIPPED | DELIVERED | COMPLETED | CANCELLED | REFUNDED
//   ShipmentStatus: PENDING | READY_TO_SHIP | SHIPPED | IN_TRANSIT | DELIVERED
//   MovementType: IN | OUT | RESERVE | RELEASE | SALE | ADJUST
//   ReservationStatus: ACTIVE | RELEASED | CONVERTED | EXPIRED
//   ReportTarget: PRODUCT | SELLER | ORDER
//   ReportStatus: OPEN | REVIEWING | RESOLVED | REJECTED

// ---------- Auth / Users ----------

model Role {
  id        String     @id @default(uuid())
  name      String     @unique // CUSTOMER | SELLER | ADMIN
  users     UserRole[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED | BANNED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles             UserRole[]
  stores            Store[]              @relation("StoreOwner")
  carts             Cart[]
  addresses         ShippingAddress[]
  orders            Order[]              @relation("CustomerOrders")
  reviews           Review[]             @relation("CustomerReviews")
  reports           Report[]             @relation("Reporter")
  notifications     Notification[]
  auditLogs         AuditLog[]           @relation("ActorLogs")
  sellerVerifications SellerVerification[] @relation("Applicant")
  reviewedVerifications SellerVerification[] @relation("Reviewer")

  @@index([email])
  @@index([status])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ---------- Stores ----------

model Store {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  logoUrl     String?
  bannerUrl   String?
  description String?
  location    String?
  contact     String?
  socials     String? // JSON string; PG: Json?
  category    String?
  theme       String   @default("MINIMAL") // MINIMAL | STREETWEAR | CLASSIC
  status      String   @default("ACTIVE") // DRAFT | ACTIVE | SUSPENDED
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products      Product[]
  orders        Order[]
  verifications SellerVerification[]
  reviews       Review[] @relation("StoreReviews")

  @@index([ownerId])
  @@index([slug])
  @@index([status])
}

model SellerVerification {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  storeId       String?
  store         Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  identityName  String
  businessName  String
  businessDesc  String?
  contact       String?
  location      String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason  String?
  reviewedById  String?
  reviewedBy    User?    @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------- Catalog ----------

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id                String   @id @default(uuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name              String
  slug              String
  brand             String?
  description       String?
  price             Int // IDR, >= 0 enforced in service
  size              String?
  chestMeasurement  String?
  lengthMeasurement String?
  material          String?
  color             String?
  condition         String   @default("GOOD") // NEW | LIKE_NEW | GOOD | FAIR
  defects           String?
  stock             Int      @default(0)
  status            String   @default("DRAFT") // DRAFT | PENDING_REVIEW | PUBLISHED | REJECTED | ARCHIVED
  tags              String   @default("[]") // JSON string; PG: String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  images       ProductImage[]
  inventory    Inventory?
  movements    InventoryMovement[]
  reservations InventoryReservation[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      Review[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([categoryId])
  @@index([status])
  @@index([price])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ---------- Inventory ----------

model Inventory {
  id           String   @id @default(uuid())
  productId    String   @unique
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  available    Int      @default(0)
  reserved     Int      @default(0)
  sold         Int      @default(0)
  lowThreshold Int     @default(3)
  updatedAt    DateTime @updatedAt
}

model InventoryMovement {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // IN | OUT | RESERVE | RELEASE | SALE | ADJUST
  qty       Int
  refOrderId String?
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model InventoryReservation {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId    String?
  qty        Int
  expiresAt  DateTime
  status     String   @default("ACTIVE") // ACTIVE | RELEASED | CONVERTED | EXPIRED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, status])
  @@index([expiresAt])
}

// ---------- Cart / Addresses ----------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
}

model ShippingAddress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  recipient  String
  phone      String
  address    String
  city       String
  province   String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// ---------- Orders / Payments / Shipments ----------

model Order {
  id                String   @id @default(uuid())
  orderNumber       String   @unique
  customerId        String
  customer          User     @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  shippingAddressId String?
  shippingAddress   ShippingAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  subtotal          Int
  shippingCost      Int      @default(0)
  total             Int
  paymentStatus     String   @default("PENDING") // PENDING | PAID | FAILED | EXPIRED | REFUNDED
  orderStatus       String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | PROCESSING | SHIPPED | DELIVERED | COMPLETED | CANCELLED | REFUNDED
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items     OrderItem[]
  payment   Payment?
  shipment  Shipment?

  @@index([customerId])
  @@index([storeId])
  @@index([orderStatus])
  @@index([createdAt])
}

// Reservations link via plain orderId string (no FK) to allow expiry cleanup.

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  snapshotName   String
  snapshotPrice  Int
  snapshotImage  String?
  snapshotBrand  String?
  qty            Int
  subtotal       Int
  createdAt      DateTime @default(now())

  review Review?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider       String   @default("sandbox")
  providerRef    String?  @unique
  idempotencyKey String   @unique
  amount         Int
  status         String   @default("PENDING") // PENDING | PAID | FAILED | EXPIRED | REFUNDED
  payload        String? // JSON string; PG: Json?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Shipment {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        String   @default("JNE")
  trackingNumber String?
  shippingCost   Int      @default(0)
  status         String   @default("PENDING") // PENDING | READY_TO_SHIP | SHIPPED | IN_TRANSIT | DELIVERED
  isSimulated    Boolean  @default(true)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------- Social proof / Ops ----------

model Review {
  id                 String   @id @default(uuid())
  orderItemId        String   @unique
  orderItem          OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  storeId            String
  store              Store    @relation("StoreReviews", fields: [storeId], references: [id], onDelete: Cascade)
  rating             Int
  comment            String?
  isVerifiedPurchase Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([storeId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String // PRODUCT | SELLER | ORDER
  targetId    String
  reason      String
  description String?
  status      String   @default("OPEN") // OPEN | REVIEWING | RESOLVED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON string; PG: Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}
